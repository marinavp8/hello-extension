{
  "manifest_version": 3,
  "name": "Hello World",
  "version": "1.5",
  "description": "Cuentas, saldos y transferencias en Anvil (localhost:8545).",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8545/*", "http://127.0.0.1:8545/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hello World",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
